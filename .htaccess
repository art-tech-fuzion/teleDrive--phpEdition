# Disable directory indexing
Options -Indexes

# Enable UTF-8 encoding
AddDefaultCharset UTF-8

# Protect sensitive files from direct browser access (Apache 2.2 & 2.4 compatible)
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
<Files ".gitignore">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Note: Security headers (X-Frame-Options: DENY, X-Content-Type-Options, CSP, etc.)
# are set exclusively by PHP in api/index.php to avoid duplicate/conflicting headers.

# Optional Apache mod_php upload limit elevation
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 512M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 512M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 512M
</IfModule>
