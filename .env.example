# TeleDrive Configuration Settings

# Admin Authentication
ADMIN_USER=admin
# Generate hash using: php -r 'echo password_hash("admin123", PASSWORD_BCRYPT);'
ADMIN_PASSWORD_HASH=$2y$10$w8T.N0Gg889M3mZkHlP/Q.iN8Xy9K9Y7E0q/Hw9s0q5lZkHlP/Q.i

# Native Session Secret Key
SESSION_SECRET=teledrive_super_secret_session_key_random_change_me_32char

# Telegram Bot Credentials & Channel IDs
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Channel where actual binary files & multi-part chunks are stored
STORAGE_CHANNEL_ID=-1001234567890

# Channel where metadata JSON messages & pinned master_manifest.json live
INDEX_CHANNEL_ID=-1009876543210

# Temporary chunk storage directory (must be writable by PHP)
TEMP_CHUNK_DIR=temp_chunks
